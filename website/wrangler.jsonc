{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tutoria-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // Better Auth's password hashing and internal async-hooks usage need
  // Node built-ins (node:crypto, node:async_hooks) that Workers only
  // provides behind this flag.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "guidotutor.com", "custom_domain": true },
    { "pattern": "www.guidotutor.com", "custom_domain": true }
  ],
  "vars": {
    // Comma-separated emails that land on `owner` instead of `free` at
    // signup (see the databaseHooks comment in worker/better-auth.ts) —
    // add teammates here (docs/reference/team.md) rather than hand-editing
    // D1. Not a secret: plan tier isn't sensitive, and this only ever
    // grants owner to an email the person themselves signs up with.
    "OWNER_EMAILS": "charlie.sandvall@gmail.com,quentinfeinaeugle@gmail.com,pauline.mophou@protonmail.com,eleanore4444@icloud.com",
    // Not secret — a price ID only identifies a subscription tier, it
    // can't be used to charge anything on its own. STRIPE_SECRET_KEY and
    // STRIPE_WEBHOOK_SECRET stay as `wrangler secret put` values instead.
    "STRIPE_PRICE_STARTER": "price_1UA34vPkkhUMaYx0GKqi6ZlY",
    "STRIPE_PRICE_PLUS": "price_1UA35hPkkhUMaYx0PLG8Vh8s"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutoria-waitlist",
      "database_id": "0a79ce70-824f-49a6-bdc0-1ea557d5d42c",
      "migrations_dir": "./migrations"
    }
  ]
}
