{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tutoria-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // Better Auth's password hashing and internal async-hooks usage need
  // Node built-ins (node:crypto, node:async_hooks) that Workers only
  // provides behind this flag.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "guidotutor.com", "custom_domain": true },
    { "pattern": "www.guidotutor.com", "custom_domain": true }
  ],
  "vars": {
    // Comma-separated emails that land on `owner` instead of `free` at
    // signup (see the databaseHooks comment in worker/better-auth.ts) —
    // add teammates here (docs/reference/team.md) rather than hand-editing
    // D1. Not a secret: plan tier isn't sensitive, and this only ever
    // grants owner to an email the person themselves signs up with.
    "OWNER_EMAILS": "charlie.sandvall@gmail.com"
  },
  // Abuse guard on /api/voice/transcribe, which spends real Aqua Voice
  // money per call — same pattern as a vision-proxy rate limiter built on
  // another branch (see docs/features/voice.md). Keyed per user, not per
  // IP. `namespace_id` is any string unique within this Worker — there is
  // nothing to create in the Cloudflare dashboard. `period` accepts only
  // 10 or 60.
  "ratelimits": [
    {
      "name": "VOICE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutoria-waitlist",
      "database_id": "0a79ce70-824f-49a6-bdc0-1ea557d5d42c",
      "migrations_dir": "./migrations"
    }
  ]
}
