{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tutoria-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "routes": [
    { "pattern": "guidotutor.com", "custom_domain": true },
    { "pattern": "www.guidotutor.com", "custom_domain": true }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutoria-waitlist",
      "database_id": "0a79ce70-824f-49a6-bdc0-1ea557d5d42c",
      "migrations_dir": "./migrations"
    }
  ]
}
