{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Kept as "tutoria-website" deliberately, even though the product is
  // Guido everywhere else: this is the actual deployed Worker name, the
  // secret (ANTHROPIC_API_KEY) is already uploaded to it, and
  // guidotutor.com / www.guidotutor.com are bound to it as custom domains
  // (see the routes block below, from claudev/charlie/desktop-google-login
  // — a real production resource users never see the name of anyway, so
  // renaming it would mean recreating the Worker, moving both domains,
  // and re-uploading the secret for zero user-visible benefit.
  "name": "tutoria-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // The Anthropic SDK's credential resolution imports node:path/node:fs
  // (for the on-disk auth profiles we don't use). Without this the Worker
  // throws at runtime on the first import, not at build time.
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "guidotutor.com", "custom_domain": true },
    { "pattern": "www.guidotutor.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "vars": {
    "GOOGLE_CLIENT_ID": ""
  },
  // Burst guard on /api/vision, which spends real Anthropic money per
  // call. Keyed per user, not per IP. `namespace_id` is any string unique
  // within this Worker — there is nothing to create in the Cloudflare
  // dashboard. `period` accepts only 10 or 60, so this can express "per
  // minute" and nothing longer; the monthly spend ceiling that actually
  // bounds the bill lives in vision.ts against the vision_usage table.
  // Counters are per-Cloudflare-location, not global, so treat this as
  // an abuse guard rather than an accounting mechanism.
  "ratelimits": [
    {
      "name": "VISION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutoria-waitlist",
      "database_id": "0a79ce70-824f-49a6-bdc0-1ea557d5d42c",
      "migrations_dir": "./migrations"
    }
  ]
}
