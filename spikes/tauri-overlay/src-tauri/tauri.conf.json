{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-overlay",
  "version": "0.1.0",
  "identifier": "com.charlie.tauri-overlay",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "sidebar",
        "title": "Guido",
        "url": "sidebar.html",
        "width": 480,
        "height": 720,
        "center": true,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false
      },
      {
        "label": "region-select",
        "title": "tutoria-region-select",
        "url": "region-select.html",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "tutoria-overlay",
        "url": "overlay.html",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "excel-demo",
        "title": "Guido",
        "url": "excel-demo.html",
        "width": 320,
        "height": 420,
        "center": true,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false
      },
      {
        "label": "excel-demo-overlay",
        "title": "guido-excel-demo-overlay",
        "url": "excel-demo-overlay.html",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
