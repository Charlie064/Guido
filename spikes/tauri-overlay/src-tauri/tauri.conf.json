{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guido",
  "version": "0.1.0",
  "identifier": "com.charlie.guido",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "sidebar",
        "title": "Guido",
        "url": "sidebar.html",
        "width": 480,
        "height": 720,
        "center": true,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false
      },
      {
        "label": "region-select",
        "title": "tutoria-region-select",
        "url": "region-select.html",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "tutoria-overlay",
        "url": "overlay.html",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2ODFFREUzNDFDRDY0RjcKUldUM1pNMUI0KzJCUmwwOE1HZmlEUUpXdm56N0xpVk0raENtVllwaFpnL2hYNndPeSt0Q3MzNXkK",
      "endpoints": [
        "https://github.com/Charlie064/Guido/releases/latest/download/latest.json"
      ]
    }
  }
}
